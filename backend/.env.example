# ============================================================
# GeoSemantic Platform — Backend Environment Configuration
# ============================================================
# Copy this to .env and fill in your values.
# Never commit .env to version control.
#
# SECURITY WARNING:
# This platform is designed for offline/air-gapped analyst workstations.
# Authentication is not enabled by default. Do not expose this service
# directly to untrusted networks without a reverse proxy / auth gateway.

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/geosemantic
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/geosemantic

# ── Application ───────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-string-in-production

# ── Data directories (absolute or relative to backend/) ───────
DATA_DIR=../data
IMAGERY_DIR=../data/imagery
TILES_DIR=../data/tiles
THUMBNAILS_DIR=../data/thumbnails
MODELS_DIR=../data/models
EXPORTS_DIR=../data/exports
MAPS_DIR=../data/maps
QDRANT_STORE_DIR=../data/qdrant_store

# ── Tile configuration ─────────────────────────────────────────
DEFAULT_TILE_SIZE=512
DEFAULT_TILE_OVERLAP=0
MIN_VALID_PIXEL_RATIO=0.3

# ── Model configuration ─────────────────────────────────────────
# Remote sensing CLIP model for semantic search
REMOTECLIP_MODEL_NAME=ViT-B-32
REMOTECLIP_CHECKPOINT_PATH=../data/models/RemoteCLIP-ViT-B-32.pt

# Visual similarity model
DINO_MODEL_NAME=vit_small_patch14_dinov2.lvd142m

# Compute device: cpu | cuda | mps
INFERENCE_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4

# ── Qdrant ────────────────────────────────────────────────────
# Local embedded mode (no server required)
QDRANT_MODE=local
QDRANT_LOCAL_PATH=../data/qdrant_store
# Server mode (uncomment if using a separate Qdrant instance)
# QDRANT_MODE=server
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

QDRANT_REMOTECLIP_COLLECTION=remoteclip_tiles
QDRANT_DINO_COLLECTION=dino_tiles

# ── Change Detection ──────────────────────────────────────────
CHANGE_CONFIDENCE_THRESHOLD=0.45
CHANGE_SUPPRESSION_THRESHOLD=0.30

# ── Local LLM (Phase 14) ──────────────────────────────────────
# Locally running Ollama instance for natural language query understanding and reasoning
LLM_ENABLED=true
LLM_PROVIDER=ollama
LLM_MODEL=llama3:latest
LLM_FALLBACK_MODEL=llama3.2:latest
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=75.0
LLM_STATUS_TIMEOUT_SECONDS=6.0
LLM_TEMPERATURE=0.1

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
