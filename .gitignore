# =============================================================================
# GeoSemantic Platform — Git Ignore Rules
# =============================================================================

# ── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# ── Python Virtual Environments ──────────────────────────────────────────────
.venv/
venv/
env/
backend/.venv/
**/venv/
**/.venv/
.Python
*.egg-info/
dist/
build/

# ── Python Bytecode & Cache ──────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# ── Node / Next.js / Frontend ────────────────────────────────────────────────
node_modules/
**/node_modules/
.next/
**/.next/
.swc/
out/
.turbo/
*.tsbuildinfo

# ── Large Satellite Data & Generated Assets ──────────────────────────────────
# All generated satellite scenes, tiles, thumbnails, previews, vector store
data/*
!data/.gitkeep
backend/data/*
!backend/data/.gitkeep
!backend/data/**/.gitkeep

# Ignore raw satellite imagery formats
*.tif
*.tiff
*.geotiff
*.png.aux.xml
*.tfw
*.lock
.lock

# ── Model Weights & Embeddings Store ─────────────────────────────────────────
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.h5
*.pkl
backend/data/qdrant_store/

# ── Operating System Artifacts ───────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ── IDE & Editor Configuration ───────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Logs & Debugging ─────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
